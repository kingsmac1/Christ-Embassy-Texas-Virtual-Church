 },
 {
  "type": "heading",
  "level": 2,
  "html": "Christ Embassy Texas Virtual Church is a church specially designed by God’s spirit and in line with the vision of the ministry to take the divine presence of God to nations of the world, demonstrating the character of the Holy Spirit."
 },
